{{> "systems/fatexcontinued/templates/components/item-header.hbs" title="FAx.Item.Extra.EditItem" item=item}}

{{> "systems/fatexcontinued/templates/item/settings/setting-input.hbs"
    headline = "FAx.Item.Extra.Name"
    field = item.name
    fieldName = "name"
    placeholder = "FAx.Item.Extra.Name"
}}

{{> "systems/fatexcontinued/templates/item/settings/setting-input.hbs"
    headline = "FAx.Item.Extra.ShortDescription"
    help = "FAx.Item.Extra.ShortDescriptionHelp"
    fieldName = "system.shortDescription"
    field = system.shortDescription
}}

<div class="fatex-setting">
    <header class="fatex-headline">
        <h3 class="fatex-headline__text">{{localize "FAx.Item.Extra.Skill"}}</h3>
    </header>

    <label>
        <select class="fatex-extra-skill-select" name="system.skill">
            <option value="">{{localize "FAx.Item.Extra.NoSkill"}}</option>
            {{#each skillOptions as |option|}}
                <option value="{{option.value}}"{{#if option.selected}} selected="selected"{{/if}}>{{option.label}}</option>
            {{/each}}
        </select>

        <span class="fatex-text-input__setting-label">{{localize "FAx.Item.Extra.SkillHelp"}}</span>
    </label>
</div>

<div class="fatex-setting">
    <header class="fatex-headline">
        <h3 class="fatex-headline__text">{{localize "FAx.Item.Extra.Bonus"}}</h3>
    </header>

    <div class="fatex-radio-group fatex-radio-group--ranks">
        {{#each availableBonuses as |bonus|}}
            <div
                class="fatex-js-radio-button fatex-radio-rank{{#if (eq bonus ../system.bonus)}} fatex-radio-rank--active{{/if}}{{#if (lt bonus 0)}} fatex-radio-rank--negative{{/if}}"
                data-value="{{bonus}}"
                data-name="system.bonus"
                data-dtype="Number"
            >
                <span class="fatex__setting__radio__value">{{#if (gte bonus 0)}}+{{/if}}{{bonus}}</span>
            </div>
        {{/each}}
    </div>

    <span class="fatex-text-input__setting-label">{{localize "FAx.Item.Extra.BonusHelp"}}</span>
</div>

{{> "systems/fatexcontinued/templates/item/settings/setting-editor.hbs"
    headline = "FAx.Item.Extra.Description"
    help = "FAx.Item.Extra.DescriptionHelp"
    fieldName = "system.description"
    field = enrichedDescription
}}

{{> "systems/fatexcontinued/templates/components/item-footer.hbs"}}
