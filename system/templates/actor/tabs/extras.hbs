{{!-- One extra: a power (top level) or one of its stunts (isStunt) --}}
{{#*inline "fatexExtraCard"}}
    <header
        class="fatex-js-sortable fatex-headline fatex-headline--fixed-icon{{#if isStunt}} fatex-headline--power-stunt{{/if}}"
        data-item-id="{{extra._id}}"
    >
        <h3 class="fatex-headline__text">
            {{~#if extra.rollInfo~}}
                <span
                    class="fatex-js-extra-roll fatex-extra__name--rollable"
                    data-item="{{extra._id}}"
                    title="{{extra.rollInfo.title}}"
                >{{extra.name}}</span>
            {{~else~}}
                {{extra.name}}
            {{~/if~}}
            {{~#if stuntCount}} <span class="fatex-extra__power-tag">{{stuntCount}}</span>{{/if~}}
        </h3>

        <div class="fatex-actions fatex-actions--headline">
            <i class="fatex-js-item-sort fatex-actions__icon fa fa-sort"></i>
            <i class="fatex-js-item-to-chat fatex-actions__icon fatex-actions__icon--no-hide fa fa-comment" data-item="{{extra._id}}"></i>
            {{#unless isStunt}}
                <i class="fatex-js-extra-add-stunt fatex-actions__icon fa fa-layer-group" data-item="{{extra._id}}" title="{{localize "FAx.Item.Extra.Power.AddStunt"}}"></i>
            {{/unless}}
            <i class="fatex-js-extra-settings fatex-actions__icon fa fa-cog" data-item="{{extra._id}}"></i>
            <i class="fatex-js-extra-delete fatex-actions__icon fatex-u-delete fa fa-trash" data-item="{{extra._id}}"></i>
            <i class="fatex-js-item-collapse fatex-actions__icon fatex-actions__icon--no-hide fa fa-chevron-up{{#if extra.system.collapsed}} fatex-actions__icon--reverse{{/if}}" data-item="{{extra._id}}"></i>
        </div>
    </header>

    {{#if extra.rollInfo}}
        <div
            class="fatex-js-extra-roll fatex-extra-roll{{#unless extra.rollInfo.found}} fatex-extra-roll--missing{{/unless}}"
            data-item="{{extra._id}}"
            title="{{extra.rollInfo.title}}"
        >
            <i class="fatex-extra-roll__icon fas fa-dice"></i>
            <span class="fatex-extra-roll__skill">{{extra.rollInfo.skill}}</span>
            {{#if extra.rollInfo.found}}
                <span class="fatex-extra-roll__rank">{{extra.rollInfo.rank}}</span>
            {{else}}
                <span class="fatex-extra-roll__missing">{{localize "FAx.Item.Extra.Roll.Missing"}}</span>
            {{/if}}
            {{#if extra.rollInfo.bonus}}
                <span class="fatex-extra-roll__bonus{{#if extra.rollInfo.isPenalty}} fatex-extra-roll__bonus--negative{{/if}}">{{extra.rollInfo.bonus}}</span>
            {{/if}}
            {{#if extra.rollInfo.cost}}
                <span class="fatex-extra-roll__cost{{#if extra.rollInfo.cannotAfford}} fatex-extra-roll__cost--missing{{/if}}">{{extra.rollInfo.cost}}</span>
            {{/if}}
        </div>
    {{/if}}

    {{#unless extra.system.collapsed}}
        {{#if extra.system.description}}
            <div class="fatex-item-description">
                {{#if extra.markdownDescription}}
                    {{{extra.markdownDescription}}}
                {{else}}
                    {{{extra.enrichedDescription}}}
                {{/if}}
            </div>
        {{/if}}
    {{/unless}}
{{/inline}}

<section class="fatex-u-full-width">
    <div class="fatex-u-padding-std fatex-item-grid">
        {{#each extraTree as |entry|}}
            <div class="fatex-extra{{#if entry.isPower}} fatex-extra--power{{/if}}" data-item-id="{{entry.extra._id}}">
                {{> fatexExtraCard extra=entry.extra stuntCount=entry.stuntCount}}

                {{!-- A power's stunts, under it (collapsing the power hides them too) --}}
                {{#if entry.isPower}}
                    {{#unless entry.extra.system.collapsed}}
                        <div class="fatex-power__stunts">
                            {{#each entry.stunts as |stunt|}}
                                <div class="fatex-extra fatex-extra--stunt" data-item-id="{{stunt._id}}">
                                    {{> fatexExtraCard extra=stunt isStunt=true}}
                                </div>
                            {{/each}}
                        </div>
                    {{/unless}}
                {{/if}}
            </div>
        {{/each}}

        <div class="fatex-js-extra-add fatex-headline fatex-headline--center fatex-headline--helper">
            <h3 class="fatex-headline__text">+</h3>
        </div>
    </div>
</section>
